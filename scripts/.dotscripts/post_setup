#!/bin/bash

set -e

cd "$(dirname "$0")/../.."

export DOTFILES=$(pwd -P)

. "$DOTFILES/scripts/.dotscripts/lib"

OS=$(dotfiles_os)

############################
## Setup required for git ##
############################

echo "> Setting up git"

# Adding extra config, look inside git/ dir. It pages through delta, and git
# errors out on every diff if delta is missing, so only include it when found.
if command -v delta >/dev/null 2>&1; then
    git config --global include.path $HOME/.gitconfig.extra
else
    echo "~ Skipping :: ~/.gitconfig.extra needs delta (brew install git-delta / pacman -S git-delta), then re-run make setup"
fi

# If hub is found, use https: instead of git: or ssh::
if command -v hub >/dev/null 2>&1; then
    git config --global hub.protocol https
fi

# # use vscode as mergetool
# if command -v code >/dev/null 2>&1; then
# 	git config --global merge.tool vscode
# 	git config --global mergetool.vscode.cmd "code --wait $MERGED"
# fi

#############################
## Setup required for bash ##
#############################

# Omarchy (and most Linux distros) keep bash as the login shell, so hook the
# shared aliases/functions from shell/ into ~/.bashrc as well. zsh sources
# them from ~/.zshrc. Zinit installs itself on the first zsh prompt.

BASH_HOOK='[[ -f ~/.dotrc/shell/init.sh ]] && source ~/.dotrc/shell/init.sh'

if [ "$OS" != "darwin" ] && dotfiles_has_package shell; then
    echo "> Setting up bash"

    if ! grep -qF "$BASH_HOOK" "$HOME/.bashrc" 2>/dev/null; then
        printf '\n# dotfiles: shared aliases and functions\n%s\n' "$BASH_HOOK" >>"$HOME/.bashrc"
        echo "+ Added shell/init.sh to ~/.bashrc"
    else
        echo "~ Already Installed :: ~/.bashrc hook"
    fi
fi

if [ "$OS" != "darwin" ]; then
    echo "~ Optional :: 'make system' installs system/linux/ into /etc (sudo)"
fi

#############################
## Setup required for tmux ##
#############################

TPM_DIR=$HOME/.tmux/plugins/tpm

if ! dotfiles_has_package tmux; then
    : # tmux config is managed elsewhere (e.g. Omarchy)
elif [ ! -d $TPM_DIR ]; then
    echo "> Setting up tmux"
    echo "~ Installing :: tmux-plugin-manager"

    git clone https://github.com/tmux-plugins/tpm $TPM_DIR

    echo "+ Done"
else
    echo "~ Already Installed :: tmux-plugin-manager"
fi

##################################
## Making ZSH the default shell ##
##################################

# Omarchy is built around bash; keep it and use the ~/.bashrc hook above.
if [ "$OS" = "omarchy" ]; then
    echo '>> All installed! Enjoy dofiles :) <<'
    exit 0
fi

find_zsh() {
	if command -v zsh >/dev/null 2>&1 && grep "$(command -v zsh)" /etc/shells >/dev/null; then
		command -v zsh
	else
		echo "/bin/zsh"
	fi
}

zsh="$(find_zsh)"

echo "> Setting 'zsh' as default shell"

test "$(expr "$SHELL" : '.*/\(.*\)')" != "zsh" &&
	command -v chsh >/dev/null 2>&1 &&
	chsh -s "$zsh" &&
	echo "> Set $("$zsh" --version) at $zsh as your default shell"

echo '>> All installed! Enjoy dofiles :) <<'
